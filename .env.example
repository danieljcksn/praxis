# Shared password gate
APP_PASSWORD="choose-a-strong-password"
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Supabase — the secret key is server-only
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
# Only required by the migration command, not by the running app:
POSTGRES_URL_NON_POOLING="postgres://..."

# Hevy — server-only
HEVY_API_KEY="your-hevy-api-key"

# Strava — server-only. Initial tokens are rotated and stored in Supabase.
STRAVA_CLIENT_ID="your-client-id"
STRAVA_CLIENT_SECRET="your-client-secret"
STRAVA_ACCESS_TOKEN="your-initial-access-token"
STRAVA_REFRESH_TOKEN="your-initial-refresh-token"
